 147                              | sentencia_iteracion_retorno sentencia_ejecucion_retorno
 148                              | sentencia_iteracion_retorno

 149  sentencia_retorno : RETURN '(' lista_exp_aritmeticas ')' ';'
 150                    | sentencia_retorno_sin_coma

 151  sentencia_retorno_sin_coma : RETURN '(' lista_exp_aritmeticas ')'

 152  termino : termino '*' factor
 153          | termino '/' factor
 154          | factor
 155          | termino_error

 156  termino_error : termino '*' error
 157                | termino '/' error
 158                | error '*' factor
 159                | error '/' factor

 160  expresion_aritmetica_toi : TOI '(' expresion_aritmetica ')'
 161                           | expresion_aritmetica_toi_error

 162  expresion_aritmetica_toi_error : TOI error expresion_aritmetica ')'
 163                                 | TOI '(' expresion_aritmetica error
 164                                 | TOI error expresion_aritmetica error

 165  simbolo_comparador : GREATER_OR_EQUAL
 166                     | LESS_OR_EQUAL
 167                     | EQUAL
 168                     | NOT_EQUAL
 169                     | '>'
 170                     | '<'

 171  variable : ID
 172           | ID '.' ID

 173  semantica_pasaje : CR SE
 174                   | CR LE
 175                   | semantica_pasaje_error

 176  semantica_pasaje_error : CR
 177                         | SE
 178                         | LE

 179  sentencia_seleccion_retorno : IF parametros_seleccion cuerpo_seleccion_retorno ENDIF
 180                              | sentencia_seleccion_sin_endif_retorno

 181  sentencia_seleccion_sin_endif_retorno : IF parametros_seleccion cuerpo_seleccion_retorno

 182  sentencia_iteracion_retorno : FOR parametros_iteracion cuerpo_iteracion_retorno

 183  factor : '-' CTE_INT
 184         | CTE_INT
 185         | '-' CTE_FLOAT
 186         | CTE_FLOAT
 187         | invocacion_funcion
 188         | variable
 189         | expresion_aritmetica_toi

 190  $$4 :

 191  cuerpo_seleccion_retorno : '{' parte_if_retorno '}' $$4 ELSE '{' parte_else_retorno '}'
