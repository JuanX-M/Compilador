  29  sentencia_iteracion_retorno : FOR parametros_iteracion cuerpo_iteracion_retorno

  30  cuerpo_iteracion_retorno : '{' cuerpo_funcion_sin_var '}'

  31  sentencia_ejecucion_sin_coma : sentencia_ejecucion

  32  sentencia_print : PRINT '(' STRING ')'
  33                  | PRINT '(' lista_exp_aritmeticas ')'
  34                  | sentencia_print_error

  35  sentencia_print_error : PRINT '(' ')'

  36  sentencia_seleccion : IF parametros_seleccion cuerpo_seleccion ELSE cuerpo_seleccion ENDIF
  37                      | IF parametros_seleccion cuerpo_seleccion ENDIF
  38                      | sentencia_seleccion_sin_endif

  39  sentencia_seleccion_sin_endif : IF parametros_seleccion cuerpo_seleccion ELSE cuerpo_seleccion
  40                                | IF parametros_seleccion cuerpo_seleccion

  41  parametros_seleccion : '(' condicion ')'
  42                       | parametros_seleccion_error

  43  parametros_seleccion_error : condicion ')'
  44                             | '(' condicion
  45                             | condicion

  46  cuerpo_seleccion : '{' cuerpo '}'
  47                   | cuerpo_seleccion_error

  48  cuerpo_seleccion_error : '{' '}'

  49  sentencia_iteracion : FOR parametros_iteracion cuerpo_iteracion

  50  parametros_iteracion : '(' encabezado_iteracion ')'
  51                       | parametros_iteracion_error

  52  parametros_iteracion_error : encabezado_iteracion ')'
  53                             | '(' encabezado_iteracion
  54                             | encabezado_iteracion

  55  encabezado_iteracion : ID FROM CTE_INT TO CTE_INT
  56                       | encabezado_iteracion_error

  57  encabezado_iteracion_error : FROM CTE_INT TO CTE_INT
  58                             | ID CTE_INT TO CTE_INT
  59                             | ID FROM TO CTE_INT
  60                             | ID FROM CTE_INT CTE_INT
  61                             | ID FROM CTE_INT TO

  62  cuerpo_iteracion : '{' cuerpo_sin_var '}'
  63                   | cuerpo_iteracion_error

  64  cuerpo_sin_var : cuerpo_sin_var sentencia_sin_var
  65                 | sentencia_sin_var

  66  sentencia_sin_var : sentencia_declarativa_sin_var
  67                    | sentencia_ejecucion_sin_var ';'
  68                    | sentencia_sin_var_asignacion_error ';'

  69  sentencia_sin_var_asignacion_error : VAR sentencia_asignacion_unaria

  70  sentencia_declarativa_sin_var : funcion_sin_var

  71  funcion_sin_var : encabezado_funcion '{' cuerpo_funcion_sin_var '}'
  72                  | sentencia_lambda_sin_var

  73  cuerpo_funcion_sin_var : cuerpo_sin_var sentencia_funcion_sin_var
  74                         | sentencia_funcion_sin_var cuerpo_sin_var
  75                         | cuerpo_sin_var sentencia_funcion_sin_var cuerpo_sin_var
  76                         | sentencia_funcion_sin_var cuerpo_sin_var sentencia_funcion_sin_var
  77                         | sentencia_funcion_sin_var

