   0  $accept : prog $end

   1  prog : ID '{' cuerpo '}'
   2       | prog_error

   3  prog_error : '{' cuerpo '}'
   4             | ID '(' cuerpo ')'
   5             | ID cuerpo
   6             | ID '{' cuerpo
   7             | ID cuerpo '}'

   8  cuerpo : cuerpo sentencia
   9         | sentencia

  10  sentencia : sentencia_declarativa
  11            | sentencia_ejecucion ';'
  12            | sentencia_ejecucion_sin_coma

  13  sentencia_declarativa : funcion

  14  sentencia_ejecucion : sentencia_print
  15                      | sentencia_seleccion
  16                      | sentencia_iteracion
  17                      | sentencia_asignacion

  18  sentencia_ejecucion_sin_coma : sentencia_ejecucion

  19  sentencia_print : PRINT '(' STRING ')'
  20                  | PRINT '(' lista_exp_aritmeticas ')'
  21                  | sentencia_print_error

  22  sentencia_print_error : PRINT '(' ')'

  23  sentencia_seleccion : IF parametros_seleccion cuerpo_seleccion ELSE cuerpo_seleccion ENDIF
  24                      | IF parametros_seleccion cuerpo_seleccion ENDIF
  25                      | sentencia_seleccion_sin_endif

  26  sentencia_seleccion_sin_endif : IF parametros_seleccion cuerpo_seleccion ELSE cuerpo_seleccion
  27                                | IF parametros_seleccion cuerpo_seleccion

  28  parametros_seleccion : '(' condicion ')'
  29                       | parametros_seleccion_error

  30  parametros_seleccion_error : condicion ')'
  31                             | '(' condicion
  32                             | condicion

  33  cuerpo_seleccion : '{' cuerpo '}'
  34                   | cuerpo_seleccion_error

  35  cuerpo_seleccion_error : '{' '}'

  36  sentencia_iteracion : FOR parametros_iteracion cuerpo_iteracion

  37  parametros_iteracion : '(' encabezado_iteracion ')'
  38                       | parametros_iteracion_error

  39  parametros_iteracion_error : encabezado_iteracion ')'
  40                             | '(' encabezado_iteracion
  41                             | encabezado_iteracion

  42  encabezado_iteracion : ID FROM CTE_INT TO CTE_INT
  43                       | encabezado_iteracion_error

  44  encabezado_iteracion_error : FROM CTE_INT TO CTE_INT
  45                             | ID CTE_INT TO CTE_INT
  46                             | ID FROM TO CTE_INT
  47                             | ID FROM CTE_INT CTE_INT
  48                             | ID FROM CTE_INT TO

  49  cuerpo_iteracion : '{' cuerpo '}'
  50                   | cuerpo_iteracion_error

  51  cuerpo_iteracion_error : '{' '}'

  52  sentencia_asignacion : sentencia_asignacion_unaria
  53                       | sentencia_asignacion_multiple

  54  sentencia_asignacion_unaria : VAR ID TWO_POINTS_ASSIGNATION expresion_aritmetica
  55                              | sentencia_asignacion_unaria_error

  56  sentencia_asignacion_unaria_error : VAR ID expresion_aritmetica

  57  sentencia_asignacion_multiple : lista_variables '=' lista_exp_aritmeticas

  58  funcion : lista_tipos FUN '(' lista_param_formales ')' '{' cuerpo '}' RETURN '(' lista_exp_aritmeticas ')' ';'
  59          | sentencia_lambda
  60          | funcion_error

  61  funcion_error : lista_tipos '(' lista_param_formales ')' '{' cuerpo '}' RETURN '(' lista_exp_aritmeticas ')' ';'

  62  sentencia_lambda : parametro_lambda cuerpo_lambda argumento_lambda

  63  parametro_lambda : '(' tipo ID ')'

  64  cuerpo_lambda : '{' cuerpo '}'

  65  argumento_lambda : '(' ID ')'
  66                   | '(' CTE_INT ')'
  67                   | '(' CTE_FLOAT ')'

  68  condicion : expresion_aritmetica simbolo_comparador factor
  69            | condicion_error

  70  condicion_error : expresion_aritmetica termino
  71                  | expresion_aritmetica simbolo_comparador
  72                  | simbolo_comparador termino

  73  expresion_aritmetica : expresion_aritmetica '+' termino
  74                       | expresion_aritmetica '-' termino
  75                       | expresion_aritmetica_toi
  76                       | termino
  77                       | expresion_aritmetica_error

  78  expresion_aritmetica_error : error '+' termino
  79                             | error '-' termino
  80                             | expresion_aritmetica '+' error
  81                             | expresion_aritmetica '-' error

  82  termino : termino '*' factor
  83          | termino '/' factor
  84          | factor
  85          | termino_error

  86  termino_error : termino '*' error
  87                | termino '/' error
  88                | error '*' factor
  89                | error '/' factor

  90  factor : CTE_INT
  91         | CTE_FLOAT
  92         | FUN '(' lista_param_reales ')'
  93         | variable

  94  expresion_aritmetica_toi : TOI '(' expresion_aritmetica ')'
  95                           | expresion_aritmetica_toi_error

  96  expresion_aritmetica_toi_error : TOI error expresion_aritmetica ')'
  97                                 | TOI '(' expresion_aritmetica error
  98                                 | TOI error expresion_aritmetica error

  99  simbolo_comparador : GREATER_OR_EQUAL
 100                     | LESS_OR_EQUAL
 101                     | EQUAL
 102                     | NOT_EQUAL
 103                     | '>'
 104                     | '<'

 105  lista_exp_aritmeticas : lista_exp_aritmeticas ',' expresion_aritmetica
 106                        | expresion_aritmetica
 107                        | lista_exp_aritmeticas_error

 108  lista_exp_aritmeticas_error : lista_exp_aritmeticas error expresion_aritmetica

 109  lista_tipos : lista_tipos ',' tipo
 110              | tipo

 111  lista_param_formales : lista_param_formales ',' parametro_formal
 112                       | parametro_formal

 113  lista_variables : lista_variables ',' variable
 114                  | variable
 115                  | lista_variables_error

 116  lista_variables_error : lista_variables variable

 117  variable : ID
 118           | ID '.' ID

 119  tipo : INT
 120       | FLOAT
 121       | STRING

 122  parametro_formal : semantica_pasaje tipo ID
 123                   | tipo ID
 124                   | parametro_formal_error

 125  parametro_formal_error : semantica_pasaje tipo
 126                         | tipo
 127                         | semantica_pasaje ID
 128                         | ID

 129  lista_param_reales : lista_param_reales ',' parametro_real
 130                     | parametro_real

 131  semantica_pasaje : CR SE
 132                   | CR LE
 133                   | semantica_pasaje_error

 134  semantica_pasaje_error : CR
 135                         | SE
 136                         | LE

 137  parametro_real : expresion_aritmetica ARROW ID

