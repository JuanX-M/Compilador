 101  sentencia_asignacion_multiple : lista_variables '=' lista_exp_aritmeticas

 102  funcion : encabezado_funcion '{' cuerpo_funcion '}'
 103          | sentencia_lambda

 104  encabezado_funcion : lista_tipos FUN ID '(' lista_param_formales ')'
 105                     | encabezado_funcion_error

 106  encabezado_funcion_error : lista_tipos FUN '(' lista_param_formales ')' '{' cuerpo_funcion '}'

 107  cuerpo_funcion : cuerpo sentencia_funcion
 108                 | sentencia_funcion cuerpo
 109                 | cuerpo sentencia_funcion cuerpo
 110                 | sentencia_funcion cuerpo sentencia_funcion
 111                 | sentencia_funcion

 112  sentencia_funcion : sentencia_ejecucion_retorno ';'
 113                    | sentencia_retorno

 114  sentencia_retorno : RETURN '(' lista_exp_aritmeticas ')' ';'

 115  sentencia_lambda : parametro_lambda cuerpo_lambda argumento_lambda

 116  parametro_lambda : '(' tipo ID ')'

 117  cuerpo_lambda : '{' cuerpo '}'
 118                | cuerpo_lambda_error

 119  cuerpo_lambda_error : cuerpo '}'

 120  argumento_lambda : '(' ID ')'
 121                   | '(' CTE_INT ')'
 122                   | '(' CTE_FLOAT ')'

 123  condicion : expresion_aritmetica simbolo_comparador factor
 124            | condicion_error

 125  condicion_error : expresion_aritmetica termino
 126                  | expresion_aritmetica simbolo_comparador
 127                  | simbolo_comparador termino

 128  expresion_aritmetica : expresion_aritmetica '+' termino
 129                       | expresion_aritmetica '-' termino
 130                       | expresion_aritmetica_toi
 131                       | termino
 132                       | expresion_aritmetica_error

 133  expresion_aritmetica_error : error '+' termino
 134                             | error '-' termino
 135                             | expresion_aritmetica '+' error
 136                             | expresion_aritmetica '-' error

 137  termino : termino '*' factor
 138          | termino '/' factor
 139          | factor
 140          | termino_error

 141  termino_error : termino '*' error
 142                | termino '/' error
 143                | error '*' factor
 144                | error '/' factor

 145  factor : CTE_INT
 146         | CTE_FLOAT
 147         | invocacion_funcion
 148         | variable

 149  invocacion_funcion : FUN ID '(' lista_param_reales ')'
 150                     | invocacion_funcion_error

 151  invocacion_funcion_error : FUN '(' lista_param_reales ')'

 152  expresion_aritmetica_toi : TOI '(' expresion_aritmetica ')'
 153                           | expresion_aritmetica_toi_error

 154  expresion_aritmetica_toi_error : TOI error expresion_aritmetica ')'
 155                                 | TOI '(' expresion_aritmetica error
 156                                 | TOI error expresion_aritmetica error

 157  simbolo_comparador : GREATER_OR_EQUAL
 158                     | LESS_OR_EQUAL
 159                     | EQUAL
 160                     | NOT_EQUAL
 161                     | '>'
 162                     | '<'

 163  lista_exp_aritmeticas : lista_exp_aritmeticas ',' expresion_aritmetica
 164                        | expresion_aritmetica
 165                        | lista_exp_aritmeticas_error

 166  lista_exp_aritmeticas_error : lista_exp_aritmeticas expresion_aritmetica

 167  lista_tipos : lista_tipos ',' tipo
 168              | tipo
 169              | lista_tipos_error

 170  lista_tipos_error : lista_tipos tipo

 171  lista_param_formales : lista_param_formales ',' parametro_formal
 172                       | parametro_formal

 173  lista_variables : lista_variables ',' variable
 174                  | variable
 175                  | lista_variables_error

 176  lista_variables_error : lista_variables variable

 177  variable : ID
 178           | ID '.' ID

 179  tipo : INT
 180       | FLOAT
 181       | STRING

 182  parametro_formal : semantica_pasaje tipo ID
 183                   | tipo ID
 184                   | parametro_formal_error

 185  parametro_formal_error : semantica_pasaje tipo
 186                         | tipo
 187                         | semantica_pasaje ID
 188                         | ID

 189  lista_param_reales : lista_param_reales ',' parametro_real
