  84                                      | IF parametros_seleccion cuerpo_seleccion_sin_var ELSE cuerpo_seleccion_retorno_sin_var ENDIF
  85                                      | IF parametros_seleccion cuerpo_seleccion_retorno_sin_var ENDIF

