   5             | ID cuerpo
   6             | ID '{' cuerpo
   7             | ID cuerpo '}'
   8             | error

   9  cuerpo : cuerpo sentencia
  10         | sentencia

  11  sentencia : sentencia_declarativa
  12            | sentencia_ejecucion ';'
  13            | sentencia_ejecucion_sin_coma

  14  sentencia_declarativa : funcion

  15  sentencia_simple : sentencia_print
  16                   | sentencia_asignacion

  17  sentencia_ejecucion : sentencia_simple
  18                      | sentencia_seleccion
  19                      | sentencia_asignacion_var
  20                      | sentencia_iteracion

