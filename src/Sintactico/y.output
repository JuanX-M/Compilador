   0  $accept : prog $end

   1  prog : ID '{' cuerpo '}'
   2       | prog_error

   3  prog_error : '{' cuerpo '}'
   4             | ID '(' cuerpo ')'
   5             | ID cuerpo
   6             | ID '{' cuerpo
   7             | ID cuerpo '}'

   8  cuerpo : cuerpo sentencia
   9         | sentencia

  10  sentencia : sentencia_declarativa
  11            | sentencia_ejecucion ';'
  12            | sentencia_ejecucion_sin_coma

  13  sentencia_declarativa : funcion

  14  sentencia_ejecucion : sentencia_print
  15                      | sentencia_seleccion
  16                      | sentencia_iteracion
  17                      | sentencia_asignacion

  18  sentencia_ejecucion_sin_coma : sentencia_ejecucion

  19  sentencia_print : PRINT '(' STRING ')'
  20                  | PRINT '(' lista_exp_aritmeticas ')'
  21                  | sentencia_print_error

  22  sentencia_print_error : PRINT '(' ')'

  23  sentencia_seleccion : IF parametros_seleccion cuerpo_seleccion ELSE cuerpo_seleccion ENDIF
  24                      | IF parametros_seleccion cuerpo_seleccion ENDIF
  25                      | sentencia_seleccion_sin_endif

  26  sentencia_seleccion_sin_endif : IF parametros_seleccion cuerpo_seleccion ELSE cuerpo_seleccion
  27                                | IF parametros_seleccion cuerpo_seleccion

  28  parametros_seleccion : '(' condicion ')'
  29                       | parametros_seleccion_error

  30  parametros_seleccion_error : condicion ')'
  31                             | '(' condicion
  32                             | condicion

  33  cuerpo_seleccion : '{' cuerpo '}'
  34                   | cuerpo_seleccion_error

  35  cuerpo_seleccion_error : '{' '}'

  36  sentencia_iteracion : FOR parametros_iteracion cuerpo_iteracion

  37  parametros_iteracion : '(' encabezado_iteracion ')'
  38                       | parametros_iteracion_error

  39  parametros_iteracion_error : encabezado_iteracion ')'
  40                             | '(' encabezado_iteracion
  41                             | encabezado_iteracion

  42  encabezado_iteracion : ID FROM CTE_INT TO CTE_INT
  43                       | encabezado_iteracion_error

  44  encabezado_iteracion_error : FROM CTE_INT TO CTE_INT
  45                             | ID CTE_INT TO CTE_INT
  46                             | ID FROM TO CTE_INT
  47                             | ID FROM CTE_INT CTE_INT
  48                             | ID FROM CTE_INT TO

  49  cuerpo_iteracion : '{' cuerpo '}'
  50                   | cuerpo_iteracion_error

  51  cuerpo_iteracion_error : '{' '}'

  52  sentencia_asignacion : sentencia_asignacion_unaria
  53                       | sentencia_asignacion_multiple

  54  sentencia_asignacion_unaria : VAR ID TWO_POINTS_ASSIGNATION expresion_aritmetica
  55                              | sentencia_asignacion_unaria_error

  56  sentencia_asignacion_unaria_error : VAR ID expresion_aritmetica

  57  sentencia_asignacion_multiple : lista_variables '=' lista_exp_aritmeticas

  58  funcion : lista_tipos FUN '(' lista_param_formales ')' '{' cuerpo '}' RETURN '(' lista_exp_aritmeticas ')' ';'
  59          | sentencia_lambda
  60          | funcion_error

  61  funcion_error : lista_tipos '(' lista_param_formales ')' '{' cuerpo '}' RETURN '(' lista_exp_aritmeticas ')' ';'

  62  sentencia_lambda : parametro_lambda cuerpo_lambda argumento_lambda

  63  parametro_lambda : '(' tipo ID ')'

  64  cuerpo_lambda : '{' cuerpo '}'
  65                | cuerpo_lambda_error

  66  cuerpo_lambda_error : cuerpo '}'

  67  argumento_lambda : '(' ID ')'
  68                   | '(' CTE_INT ')'
  69                   | '(' CTE_FLOAT ')'

  70  condicion : expresion_aritmetica simbolo_comparador factor
  71            | condicion_error

  72  condicion_error : expresion_aritmetica termino
  73                  | expresion_aritmetica simbolo_comparador
  74                  | simbolo_comparador termino

  75  expresion_aritmetica : expresion_aritmetica '+' termino
  76                       | expresion_aritmetica '-' termino
  77                       | expresion_aritmetica_toi
  78                       | termino
  79                       | expresion_aritmetica_error

  80  expresion_aritmetica_error : error '+' termino
  81                             | error '-' termino
  82                             | expresion_aritmetica '+' error
  83                             | expresion_aritmetica '-' error

  84  termino : termino '*' factor
  85          | termino '/' factor
  86          | factor
  87          | termino_error

  88  termino_error : termino '*' error
  89                | termino '/' error
  90                | error '*' factor
  91                | error '/' factor

  92  factor : CTE_INT
  93         | CTE_FLOAT
  94         | FUN '(' lista_param_reales ')'
  95         | variable

  96  expresion_aritmetica_toi : TOI '(' expresion_aritmetica ')'
  97                           | expresion_aritmetica_toi_error

  98  expresion_aritmetica_toi_error : TOI error expresion_aritmetica ')'
  99                                 | TOI '(' expresion_aritmetica error
 100                                 | TOI error expresion_aritmetica error

 101  simbolo_comparador : GREATER_OR_EQUAL
 102                     | LESS_OR_EQUAL
 103                     | EQUAL
 104                     | NOT_EQUAL
 105                     | '>'
 106                     | '<'

 107  lista_exp_aritmeticas : lista_exp_aritmeticas ',' expresion_aritmetica
 108                        | expresion_aritmetica
 109                        | lista_exp_aritmeticas_error

 110  lista_exp_aritmeticas_error : lista_exp_aritmeticas expresion_aritmetica

 111  lista_tipos : lista_tipos ',' tipo
 112              | tipo
 113              | lista_tipos_error

 114  lista_tipos_error : lista_tipos tipo

 115  lista_param_formales : lista_param_formales ',' parametro_formal
 116                       | parametro_formal

 117  lista_variables : lista_variables ',' variable
 118                  | variable
 119                  | lista_variables_error

 120  lista_variables_error : lista_variables variable

 121  variable : ID
 122           | ID '.' ID

 123  tipo : INT
 124       | FLOAT
 125       | STRING

 126  parametro_formal : semantica_pasaje tipo ID
 127                   | tipo ID
 128                   | parametro_formal_error

 129  parametro_formal_error : semantica_pasaje tipo
 130                         | tipo
 131                         | semantica_pasaje ID
 132                         | ID

 133  lista_param_reales : lista_param_reales ',' parametro_real
 134                     | parametro_real

 135  semantica_pasaje : CR SE
 136                   | CR LE
 137                   | semantica_pasaje_error

 138  semantica_pasaje_error : CR
 139                         | SE
 140                         | LE

 141  parametro_real : expresion_aritmetica ARROW ID
 142                 | parametro_real_error

 143  parametro_real_error : expresion_aritmetica ARROW

