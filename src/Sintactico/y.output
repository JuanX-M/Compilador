   0  $accept : prog $end

   1  prog : ID '{' cuerpo '}'

   2  cuerpo : cuerpo sentencia
   3         | sentencia

   4  sentencia : sentencia_declarativa
   5            | sentencia_ejecucion ';'
   6            | sentencia_lambda

   7  sentencia_declarativa : funcion

   8  sentencia_ejecucion : VAR ID TWO_POINTS_ASSIGNATION lista_exp_aritmeticas
   9                      | IF '(' condicion ')' '{' cuerpo '}' ELSE '{' cuerpo '}' ENDIF
  10                      | IF '(' condicion ')' '{' cuerpo '}' ENDIF
  11                      | PRINT '(' STRING ')'
  12                      | PRINT '(' expresion_aritmetica ')'
  13                      | FOR '(' ID FROM CTE_INT TO CTE_INT ')' '{' cuerpo '}'
  14                      | lista_variables '=' lista_exp_aritmeticas

  15  sentencia_lambda : '(' tipo ID ')' '{' cuerpo '}' '(' ID ')'
  16                   | '(' tipo ID ')' '{' cuerpo '}' '(' CTE_INT ')'
  17                   | '(' tipo ID ')' '{' cuerpo '}' '(' CTE_FLOAT ')'

  18  funcion : lista_tipos ID '(' lista_param_formales ')' '{' cuerpo '}' RETURN '(' lista_exp_aritmeticas ')' ';'

  19  expresion_aritmetica : expresion_aritmetica '+' operando
  20                       | expresion_aritmetica '-' operando
  21                       | expresion_aritmetica '*' operando
  22                       | expresion_aritmetica '/' operando
  23                       | '-' expresion_aritmetica
  24                       | TOI '(' expresion_aritmetica ')'
  25                       | operando

  26  condicion : expresion_aritmetica GREATER_OR_EQUAL expresion_aritmetica
  27            | expresion_aritmetica LESS_OR_EQUAL expresion_aritmetica
  28            | expresion_aritmetica EQUAL expresion_aritmetica
  29            | expresion_aritmetica NOT_EQUAL expresion_aritmetica
  30            | expresion_aritmetica '>' expresion_aritmetica
  31            | expresion_aritmetica '<' expresion_aritmetica

  32  lista_exp_aritmeticas : lista_exp_aritmeticas ',' expresion_aritmetica
  33                        | expresion_aritmetica

  34  lista_tipos : lista_tipos ',' tipo
  35              | tipo

  36  lista_param_formales : lista_param_formales ',' parametro_formal
  37                       | parametro_formal

  38  operando : CTE_INT
  39           | CTE_FLOAT
  40           | ID '(' lista_param_reales ')'
  41           | variable

  42  lista_variables : lista_variables ',' variable
  43                  | variable

  44  variable : ID
  45           | ID '.' ID

  46  tipo : INT
  47       | FLOAT
  48       | STRING

  49  parametro_formal : semantica_pasaje tipo ID
  50                   | tipo ID

  51  lista_param_reales : lista_param_reales ',' parametro_real
  52                     | parametro_real

  53  semantica_pasaje : CR SE
  54                   | CR LE

  55  parametro_real : operando ARROW parametro_formal

