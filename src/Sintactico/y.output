   0  $accept : prog $end

   1  prog : nombre_programa '{' cuerpo '}'
   2       | prog_error

   3  prog_error : '{' cuerpo '}'
   4             | nombre_programa '(' cuerpo ')'
   5             | nombre_programa cuerpo
   6             | nombre_programa '{' cuerpo
   7             | nombre_programa cuerpo '}'
   8             | error

   9  nombre_programa : ID

  10  cuerpo : cuerpo sentencia
  11         | sentencia

  12  sentencia : sentencia_declarativa ';'
  13            | sentencia_declarativa_sin_coma
  14            | sentencia_ejecutable

  15  sentencia_declarativa : funcion
  16                        | declaracion_variable

  17  sentencia_declarativa_sin_coma : sentencia_declarativa

  18  sentencia_ejecucion : sentencia_print
  19                      | sentencia_seleccion
  20                      | sentencia_iteracion
  21                      | sentencia_asignacion

  22  sentencia_ejecucion_sin_coma : sentencia_ejecucion

  23  funcion : encabezado_funcion '{' cuerpo_funcion '}'
  24          | sentencia_lambda

  25  declaracion_variable : declaracion_unaria

  26  sentencia_print : PRINT '(' STRING ')'
  27                  | PRINT '(' lista_exp_aritmeticas ')'
  28                  | sentencia_print_error

  29  sentencia_print_error : PRINT '(' ')'

  30  sentencia_seleccion : IF parametros_seleccion cuerpo_seleccion ENDIF
  31                      | sentencia_seleccion_sin_endif

  32  $$1 :

  33  cuerpo_seleccion : '{' parte_if '}' $$1 ELSE '{' parte_else '}'
  34                   | '{' parte_if '}'
  35                   | cuerpo_seleccion_error

  36  cuerpo_seleccion_error : '{' '}'

  37  parte_if : cuerpo_ejecutable

  38  parte_else : cuerpo_ejecutable

  39  sentencia_seleccion_sin_endif : IF parametros_seleccion cuerpo_seleccion

  40  sentencia_iteracion : FOR parametros_iteracion cuerpo_iteracion

  41  sentencia_asignacion : sentencia_asignacion_unaria
  42                       | sentencia_asignacion_multiple

  43  $$2 :

  44  encabezado_funcion : lista_tipos FUN ID $$2 '(' lista_param_formales ')'
  45                     | encabezado_funcion_error

  46  encabezado_funcion_error : lista_tipos FUN '(' lista_param_formales ')'

  47  cuerpo_funcion : lista_sentencias_funcion sentencia_retorno
  48                 | sentencia_retorno
  49                 | lista_sentencias_funcion_error

  50  lista_sentencias_funcion_error : lista_sentencias_funcion sentencia_retorno lista_sentencias_funcion
  51                                 | lista_sentencias_funcion

  52  lista_sentencias_funcion : lista_sentencias_funcion sentencia_funcion
  53                           | sentencia_funcion

  54  $$3 :

  55  sentencia_lambda : parametro_lambda $$3 cuerpo_lambda argumento_lambda

  56  declaracion_unaria : VAR ID TWO_POINTS_ASSIGNATION expresion_aritmetica
  57                     | declaracion_unaria_error

  58  declaracion_unaria_error : VAR ID expresion_aritmetica
  59                           | VAR ID '.' ID TWO_POINTS_ASSIGNATION expresion_aritmetica

  60  lista_exp_aritmeticas : lista_exp_aritmeticas ',' expresion_aritmetica
  61                        | expresion_aritmetica
  62                        | lista_exp_aritmeticas_error

  63  lista_exp_aritmeticas_error : lista_exp_aritmeticas expresion_aritmetica

  64  parametros_seleccion : '(' condicion ')'
  65                       | parametros_seleccion_error

  66  parametros_seleccion_error : condicion ')'
  67                             | '(' condicion
  68                             | condicion

  69  parametros_iteracion : '(' encabezado_iteracion ')'
  70                       | parametros_iteracion_error

  71  parametros_iteracion_error : encabezado_iteracion ')'
  72                             | '(' encabezado_iteracion
  73                             | encabezado_iteracion

  74  cuerpo_iteracion : '{' cuerpo_ejecutable '}'
  75                   | cuerpo_iteracion_error

  76  cuerpo_iteracion_error : '{' '}'

  77  sentencia_asignacion_unaria : ID TWO_POINTS_ASSIGNATION expresion_aritmetica
  78                              | ID '.' ID TWO_POINTS_ASSIGNATION expresion_aritmetica
  79                              | sentencia_asignacion_unaria_error

  80  sentencia_asignacion_unaria_error : ID expresion_aritmetica
  81                                    | ID '.' ID expresion_aritmetica

  82  sentencia_asignacion_multiple : lista_variables '=' lista_exp_aritmeticas

  83  lista_tipos : lista_tipos ',' tipo
  84              | tipo
  85              | lista_tipos_error

  86  lista_tipos_error : lista_tipos tipo

  87  lista_param_formales : lista_param_formales ',' parametro_formal
  88                       | parametro_formal

  89  sentencia_funcion : sentencia
  90                    | sentencia_ejecucion_retorno ';'

  91  parametro_lambda : '(' tipo ID ')'
  92                   | parametro_lambda_error

  93  parametro_lambda_error : '(' ID ')'
  94                         | '(' tipo ')'
  95                         | '(' error ')'

  96  cuerpo_lambda : '{' cuerpo_ejecutable '}'
  97                | cuerpo_lambda_error

  98  cuerpo_lambda_error : cuerpo_ejecutable '}'
  99                      | '{' '}'

