  22  sentencia_ejecucion_retorno : sentencia_seleccion_retorno
  23                              | sentencia_iteracion_retorno

  24  sentencia_seleccion_retorno : IF parametros_seleccion cuerpo_seleccion_retorno ELSE cuerpo_seleccion_retorno ENDIF
  25                              | IF parametros_seleccion cuerpo_seleccion_retorno ELSE cuerpo_seleccion ENDIF
  26                              | IF parametros_seleccion cuerpo_seleccion ELSE cuerpo_seleccion_retorno ENDIF
  27                              | IF parametros_seleccion cuerpo_seleccion_retorno ENDIF

