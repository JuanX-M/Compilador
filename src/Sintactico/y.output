 101                   | '(' CTE_INT ')'
 102                   | '(' CTE_FLOAT ')'
 103                   | argumento_lambda_error

 104  argumento_lambda_error : '(' error ')'

 105  expresion_aritmetica : expresion_aritmetica '+' termino
 106                       | expresion_aritmetica '-' termino
 107                       | termino
 108                       | expresion_aritmetica_error

 109  expresion_aritmetica_error : error '+' termino
 110                             | error '-' termino
 111                             | expresion_aritmetica '+' error
 112                             | expresion_aritmetica '-' error

