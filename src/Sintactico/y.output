   0  $accept : prog $end

   1  prog : ID '{' cuerpo '}'
   2       | prog_error

   3  prog_error : '{' cuerpo '}'
   4             | ID '(' cuerpo ')'
   5             | ID cuerpo
   6             | ID '{' cuerpo
   7             | ID cuerpo '}'
   8             | error

   9  cuerpo : cuerpo sentencia
  10         | sentencia

  11  sentencia : sentencia_declarativa
  12            | sentencia_ejecucion ';'
  13            | sentencia_ejecucion_sin_coma

  14  sentencia_declarativa : funcion

  15  sentencia_ejecucion : sentencia_print
  16                      | sentencia_seleccion
  17                      | sentencia_iteracion
  18                      | sentencia_asignacion

  19  sentencia_ejecucion_retorno : sentencia_seleccion_retorno
  20                              | sentencia_iteracion_retorno

  21  sentencia_seleccion_retorno : IF parametros_seleccion cuerpo_seleccion_retorno ELSE cuerpo_seleccion_retorno ENDIF
  22                              | IF parametros_seleccion cuerpo_seleccion_retorno ELSE cuerpo_seleccion ENDIF
  23                              | IF parametros_seleccion cuerpo_seleccion ELSE cuerpo_seleccion_retorno ENDIF
  24                              | IF parametros_seleccion cuerpo_seleccion_retorno ENDIF

  25  cuerpo_seleccion_retorno : '{' cuerpo_funcion '}'

  26  sentencia_iteracion_retorno : FOR parametros_iteracion cuerpo_iteracion_retorno

  27  cuerpo_iteracion_retorno : '{' cuerpo_funcion '}'

  28  sentencia_ejecucion_sin_coma : sentencia_ejecucion

  29  sentencia_print : PRINT '(' STRING ')'
  30                  | PRINT '(' lista_exp_aritmeticas ')'
  31                  | sentencia_print_error

  32  sentencia_print_error : PRINT '(' ')'

  33  sentencia_seleccion : IF parametros_seleccion cuerpo_seleccion ELSE cuerpo_seleccion ENDIF
  34                      | IF parametros_seleccion cuerpo_seleccion ENDIF
  35                      | sentencia_seleccion_sin_endif

  36  sentencia_seleccion_sin_endif : IF parametros_seleccion cuerpo_seleccion ELSE cuerpo_seleccion
  37                                | IF parametros_seleccion cuerpo_seleccion

  38  parametros_seleccion : '(' condicion ')'
  39                       | parametros_seleccion_error

  40  parametros_seleccion_error : condicion ')'
  41                             | '(' condicion
  42                             | condicion

  43  cuerpo_seleccion : '{' cuerpo '}'
  44                   | cuerpo_seleccion_error

  45  cuerpo_seleccion_error : '{' '}'

  46  sentencia_iteracion : FOR parametros_iteracion cuerpo_iteracion

  47  parametros_iteracion : '(' encabezado_iteracion ')'
  48                       | parametros_iteracion_error

  49  parametros_iteracion_error : encabezado_iteracion ')'
  50                             | '(' encabezado_iteracion
  51                             | encabezado_iteracion

  52  encabezado_iteracion : ID FROM CTE_INT TO CTE_INT
  53                       | encabezado_iteracion_error

  54  encabezado_iteracion_error : FROM CTE_INT TO CTE_INT
  55                             | ID CTE_INT TO CTE_INT
  56                             | ID FROM TO CTE_INT
  57                             | ID FROM CTE_INT CTE_INT
  58                             | ID FROM CTE_INT TO

  59  cuerpo_iteracion : '{' cuerpo '}'
  60                   | cuerpo_iteracion_error

  61  cuerpo_iteracion_error : '{' '}'

  62  sentencia_asignacion : sentencia_asignacion_unaria
  63                       | sentencia_asignacion_multiple

  64  sentencia_asignacion_unaria : VAR ID TWO_POINTS_ASSIGNATION expresion_aritmetica
  65                              | sentencia_asignacion_unaria_error

  66  sentencia_asignacion_unaria_error : VAR ID expresion_aritmetica

  67  sentencia_asignacion_multiple : lista_variables '=' lista_exp_aritmeticas

  68  funcion : encabezado_funcion '{' cuerpo_funcion '}'
  69          | sentencia_lambda
  70          | funcion_error

  71  encabezado_funcion : lista_tipos FUN ID '(' lista_param_formales ')'

  72  cuerpo_funcion : cuerpo sentencia_funcion
  73                 | sentencia_funcion cuerpo
  74                 | cuerpo sentencia_funcion cuerpo
  75                 | sentencia_funcion cuerpo sentencia_funcion
  76                 | sentencia_funcion

  77  sentencia_funcion : sentencia_ejecucion_retorno
  78                    | sentencia_retorno

  79  sentencia_retorno : RETURN '(' lista_exp_aritmeticas ')' ';'

  80  funcion_error : lista_tipos FUN '(' lista_param_formales ')' '{' cuerpo '}' RETURN '(' lista_exp_aritmeticas ')' ';'

  81  sentencia_lambda : parametro_lambda cuerpo_lambda argumento_lambda

  82  parametro_lambda : '(' tipo ID ')'

  83  cuerpo_lambda : '{' cuerpo '}'
  84                | cuerpo_lambda_error

  85  cuerpo_lambda_error : cuerpo '}'

  86  argumento_lambda : '(' ID ')'
  87                   | '(' CTE_INT ')'
  88                   | '(' CTE_FLOAT ')'

  89  condicion : expresion_aritmetica simbolo_comparador factor
  90            | condicion_error

  91  condicion_error : expresion_aritmetica termino
  92                  | expresion_aritmetica simbolo_comparador
  93                  | simbolo_comparador termino

  94  expresion_aritmetica : expresion_aritmetica '+' termino
  95                       | expresion_aritmetica '-' termino
  96                       | expresion_aritmetica_toi
  97                       | termino
  98                       | expresion_aritmetica_error

  99  expresion_aritmetica_error : error '+' termino
 100                             | error '-' termino
 101                             | expresion_aritmetica '+' error
 102                             | expresion_aritmetica '-' error

 103  termino : termino '*' factor
 104          | termino '/' factor
 105          | factor
 106          | termino_error

 107  termino_error : termino '*' error
 108                | termino '/' error
 109                | error '*' factor
 110                | error '/' factor

 111  factor : CTE_INT
 112         | CTE_FLOAT
 113         | FUN ID '(' lista_param_reales ')'
 114         | variable

 115  expresion_aritmetica_toi : TOI '(' expresion_aritmetica ')'
 116                           | expresion_aritmetica_toi_error

 117  expresion_aritmetica_toi_error : TOI error expresion_aritmetica ')'
 118                                 | TOI '(' expresion_aritmetica error
 119                                 | TOI error expresion_aritmetica error

 120  simbolo_comparador : GREATER_OR_EQUAL
 121                     | LESS_OR_EQUAL
 122                     | EQUAL
 123                     | NOT_EQUAL
 124                     | '>'
 125                     | '<'

 126  lista_exp_aritmeticas : lista_exp_aritmeticas ',' expresion_aritmetica
 127                        | expresion_aritmetica
 128                        | lista_exp_aritmeticas_error

 129  lista_exp_aritmeticas_error : lista_exp_aritmeticas expresion_aritmetica

 130  lista_tipos : lista_tipos ',' tipo
 131              | tipo
 132              | lista_tipos_error

 133  lista_tipos_error : lista_tipos tipo

 134  lista_param_formales : lista_param_formales ',' parametro_formal
 135                       | parametro_formal

 136  lista_variables : lista_variables ',' variable
 137                  | variable
 138                  | lista_variables_error

 139  lista_variables_error : lista_variables variable

 140  variable : ID
 141           | ID '.' ID

 142  tipo : INT
 143       | FLOAT
 144       | STRING

 145  parametro_formal : semantica_pasaje tipo ID
 146                   | tipo ID
 147                   | parametro_formal_error

 148  parametro_formal_error : semantica_pasaje tipo
 149                         | tipo
 150                         | semantica_pasaje ID
 151                         | ID

 152  lista_param_reales : lista_param_reales ',' parametro_real
 153                     | parametro_real

 154  semantica_pasaje : CR SE
 155                   | CR LE
 156                   | semantica_pasaje_error

 157  semantica_pasaje_error : CR
 158                         | SE
 159                         | LE

 160  parametro_real : expresion_aritmetica ARROW ID
 161                 | parametro_real_error

 162  parametro_real_error : expresion_aritmetica ARROW

